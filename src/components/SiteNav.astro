---
const base = import.meta.env.BASE_URL.replace(/\/?$/, "/");
---

<header
  id="header"
  class="fixed top-0 left-0 right-0 z-50 transition-all duration-300"
>
  <nav class="max-w-7xl mx-auto px-4 sm:px-8 py-3 sm:py-4">
    <ul class="flex items-center justify-center gap-5 sm:gap-8 text-sm sm:text-base">
      <li>
        <a
          href={`${base}about`}
          class="text-gray-700 hover:text-black transition-colors font-medium"
        >
          About
        </a>
      </li>
      <li>
        <a
          href={`${base}#work`}
          class="text-gray-700 hover:text-black transition-colors font-medium"
        >
          Work
        </a>
      </li>
      <li>
        <a
          href={`${base}writing`}
          class="text-gray-700 hover:text-black transition-colors font-medium"
        >
          Writing
        </a>
      </li>
    </ul>
  </nav>
</header>

<script>
  window.addEventListener("scroll", () => {
    const header = document.getElementById("header");
    if (window.scrollY > 100) {
      header?.classList.add("bg-white/80", "backdrop-blur-sm");
    } else {
      header?.classList.remove("bg-white/80", "backdrop-blur-sm");
    }
  });
</script>

<style>
  html {
    scroll-behavior: smooth;
  }
</style>
