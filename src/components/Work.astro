---
import { siteConfig } from "../config";

const base = import.meta.env.BASE_URL.replace(/\/?$/, "/");
const hasWork = siteConfig.workSections && siteConfig.workSections.length > 0;
---

{
  hasWork && (
    <section id="work" class="p-8 sm:p-12 md:p-16 lg:p-24">
      <div>
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-16 items-start">
          <div class="lg:col-span-4">
            <h2 class="text-3xl sm:text-4xl md:text-5xl xl:text-7xl font-bold text-gray-900">
              Work
            </h2>
            <div
              class="w-[75px] h-[5px] mt-2 rounded-full"
              style={`background-color: ${siteConfig.accentColor}`}
            />
          </div>

          <div class="lg:col-span-8">
            <div class="space-y-12">
              {siteConfig.workSections.map((section) => (
                <div>
                  <h3
                    class="text-sm font-mono uppercase tracking-wide mb-4"
                    style={{ color: siteConfig.accentColor }}
                  >
                    {section.label}
                  </h3>
                  <ul class="space-y-3">
                    {section.items.map((item) => (
                      <li class="text-xl sm:text-2xl font-bold text-gray-900">
                        {item.links.map((link, i) => (
                          <>
                            {i > 0 && (
                              <span class="text-gray-400 font-normal mx-1">—</span>
                            )}
                            <a
                              href={`${base}${link.href.replace(/^\//, "")}`}
                              class="hover:text-gray-600 transition-colors"
                            >
                              {link.label}
                            </a>
                          </>
                        ))}
                      </li>
                    ))}
                  </ul>
                </div>
              ))}
            </div>
          </div>
        </div>
      </div>
    </section>
  )
}
