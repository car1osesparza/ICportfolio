---
import { siteConfig } from "../config";
const { recognition } = siteConfig;
---

{
  recognition && (
    <section id="recognition" class="p-8 sm:p-12 md:p-16 lg:p-24 bg-gray-50">
      <div>
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-16 items-start">
          <div class="lg:col-span-4">
            <h2 class="text-3xl sm:text-4xl md:text-5xl xl:text-7xl font-bold text-gray-900">
              {recognition.label}
            </h2>
            <div
              class="w-[75px] h-[5px] mt-2 rounded-full"
              style={`background-color: ${siteConfig.accentColor}`}
            />
          </div>

          <div class="lg:col-span-8">
            <ul class="space-y-4">
              {
                recognition.items.map((item) => (
                  <li class="bg-white rounded-lg shadow-sm border border-gray-100 p-4 sm:p-5 md:p-6">
                    <p
                      class="text-sm sm:text-base font-semibold"
                      style={{ color: siteConfig.accentColor }}
                    >
                      {item.publication}
                    </p>
                    <p class="text-sm sm:text-base text-gray-600 mt-1">{item.title}</p>
                  </li>
                ))
              }
            </ul>
          </div>
        </div>
      </div>
    </section>
  )
}
