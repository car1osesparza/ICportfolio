---
import CaseStudyHeader from "../components/CaseStudyHeader.astro";
import CaseStudyFooter from "../components/CaseStudyFooter.astro";
import { siteConfig } from "../config";
import "../styles/global.css";

const base = import.meta.env.BASE_URL.replace(/\/?$/, "/");
const img = (path: string) => `${base}${path.replace(/^\//, "")}`;

const covers = [
  { src: "/images/publishing/9781506486277c.jpg", alt: "Book cover" },
  { src: "/images/publishing/9781506493374c.jpg", alt: "Book cover" },
  { src: "/images/publishing/9781506499147c.jpg", alt: "Book cover" },
  { src: "/images/publishing/9798341900936.jpg", alt: "Book cover" },
  { src: "/images/publishing/9798889830757c.jpg", alt: "Book cover" },
  { src: "/images/publishing/EmptyWords.jpg", alt: "Empty Words — book cover" },
  { src: "/images/publishing/Likenes_F2.jpg", alt: "Likeness — book cover" },
  { src: "/images/publishing/i-mafan.jpg", alt: "I Mafan — book cover" },
  { src: "/images/publishing/shy_F1.jpg", alt: "Shy — book cover" },
];
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <meta
      name="description"
      content="Creative direction across seventy annual book launches at Rockridge Press and Broadleaf Books."
    />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:ital,wght@0,100;0,200;0,300;0,400;0,500;0,600;0,700;1,100;1,200;1,300;1,400;1,500;1,600;1,700&display=swap"
      rel="stylesheet"
    />
    <title>Rockridge Press + Broadleaf Books — {siteConfig.name}</title>
  </head>
  <body>
    <CaseStudyHeader />

    <main class="pt-24 pb-16">
      <div class="max-w-4xl mx-auto px-6 lg:px-8">
        <div class="mb-8">
          <a
            href={`${base}#work`}
            class="inline-flex items-center text-gray-600 hover:text-black transition-colors font-medium"
          >
            <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path>
            </svg>
            Back to Work
          </a>
        </div>

        <header class="mb-16">
          <h1 class="text-4xl md:text-5xl font-bold text-gray-900 mb-6">
            Rockridge Press + Broadleaf Books
          </h1>
        </header>

        <article class="prose prose-lg max-w-none">
          <p class="text-gray-700 mb-4">
            Publishing produces an unusual design problem: every season brings dozens of entirely new products, each with its own audience, competitors, positioning challenges, and commercial goals. The challenge isn't designing one successful cover. It's maintaining creative quality and strategic clarity across seventy launches a year.
          </p>
          <p class="text-gray-700 mb-4">
            My role begins well before design. I work alongside publishers, editors, sales leaders, and marketers to shape product positioning, naming, subtitling, and market strategy before a creative brief exists. The visual direction grows out of those conversations rather than arriving downstream of them.
          </p>
          <p class="text-gray-700 mb-4">
            From there, I lead illustrators, photographers, and freelance designers through execution while balancing editorial intent, commercial realities, production constraints, and aggressive schedules. The goal isn't consistency of style but consistency of thinking—giving every project its own voice while holding all of them to the same standard of craft.
          </p>
          <p class="text-gray-700 mb-12">
            Over fourteen years I've directed work across fiction, nonfiction, spirituality, business, children's publishing, and education while contributing to roughly seventy launches each year. The work has been recognized by LitHub, Casual Optimist, and Paste Magazine, but the accomplishment I'm proudest of is maintaining creative ambition at production scale, where systems and leadership matter just as much as aesthetics.
          </p>

          <div class="not-prose grid grid-cols-2 sm:grid-cols-3 gap-4">
            {
              covers.map((cover) => (
                <div class="aspect-[2/3] rounded-lg overflow-hidden bg-gray-100">
                  <img
                    src={img(cover.src)}
                    alt={cover.alt}
                    class="w-full h-full object-cover"
                    loading="lazy"
                  />
                </div>
              ))
            }
          </div>
        </article>

        <nav class="mt-16 pt-8 border-t border-gray-200">
          <div class="flex justify-between items-center">
            <a
              href={`${base}creative-leadership-at-scale`}
              class="text-gray-600 hover:text-black transition-colors font-medium"
            >
              ← Creative Leadership at Scale
            </a>
            <a href={`${base}#work`} class="text-gray-600 hover:text-black transition-colors font-medium">
              Back to Work →
            </a>
          </div>
        </nav>
      </div>
    </main>

    <CaseStudyFooter />
  </body>
</html>
