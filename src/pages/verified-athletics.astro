---
import CaseStudyHeader from "../components/CaseStudyHeader.astro";
import CaseStudyFooter from "../components/CaseStudyFooter.astro";
import { siteConfig } from "../config";
import "../styles/global.css";

const base = import.meta.env.BASE_URL.replace(/\/?$/, "/");
const img = (path: string) => `${base}${path.replace(/^\//, "")}`;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <meta
      name="description"
      content="Brand strategy, identity, product experience, and design systems for an early-stage sports technology startup."
    />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:ital,wght@0,100;0,200;0,300;0,400;0,500;0,600;0,700;1,100;1,200;1,300;1,400;1,500;1,600;1,700&display=swap"
      rel="stylesheet"
    />
    <title>Verified Athletics — {siteConfig.name}</title>
  </head>
  <body>
    <CaseStudyHeader />

    <main class="pt-24 pb-16">
      <div class="max-w-4xl mx-auto px-6 lg:px-8">
        <div class="mb-8">
          <a
            href={`${base}#work`}
            class="inline-flex items-center text-gray-600 hover:text-black transition-colors font-medium"
          >
            <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path>
            </svg>
            Back to Work
          </a>
        </div>

        <header class="mb-16">
          <h1 class="text-4xl md:text-5xl font-bold text-gray-900 mb-6">Verified Athletics</h1>
          <p class="text-xl text-gray-600">
            Brand strategy, identity, product experience, and design systems for an early-stage sports technology startup.
          </p>
        </header>

        <article class="prose prose-lg max-w-none">
          <p class="text-gray-700 mb-4">
            Verified Athletics had been building product for eight years without a design system underneath any of it: three disconnected dashboards, a stock logo, no visual language tying the product to the marketing site. As fractional creative director, I led the brand strategy, identity design, product experience, and design system work that the company needed but hadn't yet prioritized.
          </p>
          <p class="text-gray-700 mb-8">
            The brand gap was the first thing I went after. I ran an independent discovery process, identified where the identity was working against them, and secured stakeholder buy-in for a full visual rebrand: new logo, color system, and identity framework built to scale into the product as the company grew.
          </p>

          <figure class="not-prose mb-16">
            <!-- Mobile: stacked -->
            <div class="flex flex-col gap-4 md:hidden">
              <img
                src={img("images/case-studies/verified-athletics/brand-logo.png")}
                alt="Verified Athletics logo construction and scale guidelines"
                class="w-full rounded-lg shadow-md border border-gray-200/80 bg-white"
              />
              <img
                src={img("images/case-studies/verified-athletics/brand-wordmark.png")}
                alt="Verified Athletics wordmark typography and customization details"
                class="w-full rounded-lg shadow-md border border-gray-200/80 bg-white"
              />
              <img
                src={img("images/case-studies/verified-athletics/brand-lockups.png")}
                alt="Verified Athletics logo lockup variations"
                class="w-full rounded-lg shadow-md border border-gray-200/80 bg-white"
              />
            </div>
            <!-- Desktop: overlapping spread, logo in front -->
            <div class="relative hidden md:block h-[36rem]">
              <img
                src={img("images/case-studies/verified-athletics/brand-lockups.png")}
                alt=""
                aria-hidden="true"
                class="absolute bottom-0 left-[10%] w-[68%] rounded-lg shadow-md border border-gray-200/80 bg-white z-10"
              />
              <img
                src={img("images/case-studies/verified-athletics/brand-wordmark.png")}
                alt=""
                aria-hidden="true"
                class="absolute top-[22%] right-0 w-[76%] rounded-lg shadow-lg border border-gray-200/80 bg-white z-20"
              />
              <img
                src={img("images/case-studies/verified-athletics/brand-logo.png")}
                alt="Verified Athletics brand identity system — logo construction, wordmark, and lockups"
                class="absolute top-0 left-0 w-[78%] rounded-lg shadow-xl border border-gray-200/80 bg-white z-30"
              />
            </div>
            <figcaption class="text-gray-600 text-sm mt-4">
              Brand identity system — logo construction, wordmark, and lockups
            </figcaption>
          </figure>

          <p class="text-gray-700 mb-4">
            The sales experience was next. The homepage wasn't converting, and the reasons weren't hard to find once I looked. It was describing features when it needed to be making an argument. I diagnosed the conversion problems, wrote the strategic recommendations, and delivered the new customer-facing site myself, designed in Figma, shipped as production Next.js code through Cursor, merged directly into the engineering repo via Git branches.
          </p>
          <p class="text-gray-700 mb-12">
            Alongside the brand and site work, I built a Figma component library and used it to unify three disconnected product dashboards into a single coherent visual architecture. Part of the brief was migrating users off a recently acquired competitor's product and onto theirs, which was costing them $10,000 a month to keep running in parallel. Shipping UI code directly cut the handoff friction that normally sits between design and engineering, and let me move faster than a traditional design-to-dev process would allow.
          </p>

          <section class="not-prose space-y-8 mb-4">
            <figure>
              <img
                src={img("images/case-studies/verified-athletics-dashboard.jpg")}
                alt="Unified product dashboard UI"
                class="w-full rounded-lg"
              />
              <figcaption class="text-gray-600 text-sm mt-2">Unified product dashboard</figcaption>
            </figure>
            <figure>
              <img
                src={img("images/case-studies/verified-athletics/homepage-before.png")}
                alt="Verified Athletics homepage before redesign"
                class="w-full rounded-lg"
              />
              <figcaption class="text-gray-600 text-sm mt-2">Homepage — before</figcaption>
            </figure>
            <figure>
              <img
                src={img("images/case-studies/verified-athletics/homepage-after.png")}
                alt="Verified Athletics homepage after redesign"
                class="w-full rounded-lg"
              />
              <figcaption class="text-gray-600 text-sm mt-2">Homepage — after</figcaption>
            </figure>
          </section>
        </article>

        <nav class="mt-16 pt-8 border-t border-gray-200">
          <div class="flex justify-between items-center">
            <a href={`${base}aziz`} class="text-gray-600 hover:text-black transition-colors font-medium">
              ← Aziz
            </a>
            <a
              href={`${base}creative-leadership-at-scale`}
              class="text-gray-600 hover:text-black transition-colors font-medium"
            >
              Next: Creative Leadership at Scale →
            </a>
          </div>
        </nav>
      </div>
    </main>

    <CaseStudyFooter />
  </body>
</html>
