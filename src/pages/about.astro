---
import CaseStudyHeader from "../components/CaseStudyHeader.astro";
import CaseStudyFooter from "../components/CaseStudyFooter.astro";
import { siteConfig } from "../config";
import "../styles/global.css";

const base = import.meta.env.BASE_URL.replace(/\/?$/, "/");
const { aboutPage } = siteConfig;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content="About Carlos Esparza — creative director based in Maui, Hawaii." />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:ital,wght@0,100;0,200;0,300;0,400;0,500;0,600;0,700;1,100;1,200;1,300;1,400;1,500;1,600;1,700&display=swap"
      rel="stylesheet"
    />
    <title>About — {siteConfig.name}</title>
  </head>
  <body>
    <CaseStudyHeader />

    <main class="pt-24 pb-16">
      <div class="max-w-4xl mx-auto px-6 lg:px-8">
        <div class="mb-8">
          <a
            href={`${base}`}
            class="inline-flex items-center text-gray-600 hover:text-black transition-colors font-medium"
          >
            <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path>
            </svg>
            Back to Home
          </a>
        </div>

        <header class="mb-16">
          <h1 class="text-4xl md:text-5xl font-bold text-gray-900 mb-6">{aboutPage.headline}</h1>
        </header>

        <article class="prose prose-lg max-w-none space-y-8">
          {
            aboutPage.body.map((paragraph) => (
              <p class="text-lg sm:text-xl leading-relaxed text-gray-600">{paragraph}</p>
            ))
          }
          <p>
            <a
              href={`mailto:${aboutPage.email}`}
              class="text-lg font-medium transition-colors hover:opacity-80 no-underline"
              style={{ color: siteConfig.accentColor }}
            >
              {aboutPage.email}
            </a>
          </p>
        </article>
      </div>
    </main>

    <CaseStudyFooter />
  </body>
</html>
